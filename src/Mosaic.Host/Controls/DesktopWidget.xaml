<UserControl x:Class="Mosaic.Host.Controls.DesktopWidget" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Mosaic.Host.Controls" Focusable="True" PreviewKeyDown="OnPlacementKeyDown">
  <UserControl.Resources><ResourceDictionary Source="../Themes/WidgetTemplates.xaml"/></UserControl.Resources>
  <Grid>
    <Border x:Name="Card" Background="{DynamicResource WidgetBrush}" CornerRadius="16" Padding="20,16" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="WidgetTitle" Foreground="{DynamicResource MutedBrush}" FontSize="12" IsHitTestVisible="False"/>
        <ContentControl x:Name="WidgetContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ContentTemplateSelector="{StaticResource WidgetSelector}"/>
        <Grid x:Name="SaveStatusArea" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed" DataContext="{Binding Path=(controls:WidgetContext.Owner), RelativeSource={RelativeSource Self}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding ContentSaveStatus}" ToolTip="{Binding ContentSaveStatus}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding ContentSaveError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <Button Grid.Column="1" Content="重试" Command="{Binding RetryContentSaveCommand}" Style="{StaticResource QuietButton}" Padding="8,0" MinHeight="28" Visibility="{Binding ContentSaveError, Converter={StaticResource BoolVisibility}}"/>
        </Grid>
      </Grid>
    </Border>
    <Grid x:Name="EditHandles" Visibility="Collapsed">
      <Thumb x:Name="MoveHandle" Height="36" VerticalAlignment="Top" Cursor="SizeAll" DragDelta="OnMove" ToolTip="移动桌面控件" AutomationProperties.Name="移动桌面控件">
        <Thumb.Template><ControlTemplate><Border Background="{DynamicResource SelectionBrush}" CornerRadius="16,16,0,0"><TextBlock Text="⠿" HorizontalAlignment="Right" Margin="0,4,14,0" FontSize="20"/></Border></ControlTemplate></Thumb.Template>
      </Thumb>
      <Thumb x:Name="SizeHandle" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="OnResize" ToolTip="调整桌面控件大小" AutomationProperties.Name="调整桌面控件大小">
        <Thumb.Template><ControlTemplate><Border Background="{DynamicResource SelectionBrush}" CornerRadius="6,0,16,0"><TextBlock Text="◢" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border></ControlTemplate></Thumb.Template>
      </Thumb>
    </Grid>
  </Grid>
</UserControl>
