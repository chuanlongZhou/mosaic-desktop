<UserControl x:Class="Mosaic.Host.Controls.DesktopWidget" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="False">
  <UserControl.Resources><ResourceDictionary Source="../Themes/WidgetTemplates.xaml"/></UserControl.Resources>
  <Grid>
    <Border x:Name="Card" Background="#D9172535" CornerRadius="16" Padding="20,16" BorderBrush="#79C2FF" BorderThickness="0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="WidgetTitle" Foreground="#A9C8DF" FontSize="12" IsHitTestVisible="False"/>
        <ContentControl x:Name="WidgetContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ContentTemplateSelector="{StaticResource WidgetSelector}"/>
      </Grid>
    </Border>
    <Grid x:Name="EditHandles" Visibility="Collapsed">
      <Thumb x:Name="MoveHandle" Height="36" VerticalAlignment="Top" Cursor="SizeAll" DragDelta="OnMove" ToolTip="移动桌面控件" AutomationProperties.Name="移动桌面控件">
        <Thumb.Template><ControlTemplate><Border Background="#70528BB5" CornerRadius="16,16,0,0"><TextBlock Text="⠿" HorizontalAlignment="Right" Margin="0,4,14,0" FontSize="20"/></Border></ControlTemplate></Thumb.Template>
      </Thumb>
      <Thumb x:Name="SizeHandle" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="OnResize" ToolTip="调整桌面控件大小" AutomationProperties.Name="调整桌面控件大小">
        <Thumb.Template><ControlTemplate><Border Background="#70528BB5" CornerRadius="6,0,16,0"><TextBlock Text="◢" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border></ControlTemplate></Thumb.Template>
      </Thumb>
    </Grid>
  </Grid>
</UserControl>
