<Window x:Class="Mosaic.Host.Views.DesktopBarWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mosaic · 时间与菜单栏" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Height="32"
        AllowsTransparency="True" Background="Transparent" ClipToBounds="True" MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
  <Window.Resources>
    <DataTemplate x:Key="TrayIconTemplate">
      <Button Style="{StaticResource QuietButton}" Width="28" Height="28" MinHeight="28" Padding="5" ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}"
              PreviewMouseDown="OnTrayMouseDown" PreviewMouseUp="OnTrayMouseUp" MouseEnter="OnTrayMouseEnter" MouseLeave="OnTrayMouseLeave" Click="OnTrayKeyboardClick">
        <Image Source="{Binding Icon}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Button>
    </DataTemplate>
  </Window.Resources>
  <Border x:Name="BarContent" Height="32" VerticalAlignment="Top" Visibility="Collapsed" Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Button x:Name="MenuButton" Content="MOSAIC" Click="OnMenuClick" Style="{StaticResource QuietButton}" FontSize="12" FontWeight="SemiBold" Padding="8,0" MinHeight="26"/><Button Content="搜索" Click="OnSearchClick" Style="{StaticResource QuietButton}" FontSize="12" Padding="12,0" MinHeight="26"/><Button Content="桌面组件" Click="OnSettingsClick" Style="{StaticResource QuietButton}" FontSize="12" Padding="8,0" MinHeight="26"/></StackPanel>
      <StackPanel x:Name="StatusArea" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="WorkspaceLabel" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,14,0" VerticalAlignment="Center"/>
        <Button x:Name="HiddenIconsButton" Content="⌃" Click="OnHiddenIconsClick" Style="{StaticResource QuietButton}" Padding="7,0" MinHeight="28" ToolTip="显示隐藏的应用图标" AutomationProperties.Name="显示隐藏的应用图标"/>
        <ItemsControl x:Name="PinnedTrayIcons" ItemTemplate="{StaticResource TrayIconTemplate}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
        <Button x:Name="InputLanguageButton" Click="OnInputLanguageClick" Style="{StaticResource QuietButton}" Padding="7,0" MinHeight="28" FontSize="12" AutomationProperties.Name="输入语言与输入法"/>
        <Button x:Name="NetworkButton" Content="&#xE701;" FontFamily="Segoe MDL2 Assets" Click="OnNetworkClick" Style="{StaticResource QuietButton}" Padding="7,0" MinHeight="28" AutomationProperties.Name="网络状态"/>
        <Button x:Name="VolumeButton" Content="&#xE767;" FontFamily="Segoe MDL2 Assets" Click="OnVolumeClick" Style="{StaticResource QuietButton}" Padding="7,0" MinHeight="28" AutomationProperties.Name="音量状态"/>
        <Button x:Name="BatteryButton" Click="OnBatteryClick" Style="{StaticResource QuietButton}" Padding="7,0" MinHeight="28" AutomationProperties.Name="电池和电源状态"/>
        <Button x:Name="ClockButton" Click="OnClockClick" Style="{StaticResource QuietButton}" Padding="10,0,0,0" MinHeight="28" ToolTip="查看日期和日历">
          <TextBlock x:Name="DateTimeLabel" FontSize="12" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" AutomationProperties.Name="当前日期和时间"/>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</Window>
