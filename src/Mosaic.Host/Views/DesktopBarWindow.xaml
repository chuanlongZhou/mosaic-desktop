<Window x:Class="Mosaic.Host.Views.DesktopBarWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mosaic · 时间与菜单栏" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Height="32"
        AllowsTransparency="True" Background="Transparent" MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
  <Border x:Name="BarContent" Background="#121C2A" BorderBrush="#33465B" BorderThickness="0,0,0,1" Padding="12,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Button x:Name="MenuButton" Content="MOSAIC" Click="OnMenuClick" Style="{StaticResource QuietButton}" FontSize="11" FontWeight="SemiBold" Padding="8,0" MinHeight="26"/><Button Content="搜索" Click="OnSearchClick" Style="{StaticResource QuietButton}" FontSize="11" Padding="12,0" MinHeight="26"/><Button Content="桌面插件" Click="OnSettingsClick" Style="{StaticResource QuietButton}" FontSize="11" Padding="8,0" MinHeight="26"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="WorkspaceLabel" Foreground="#88A6BD" FontSize="11" Margin="0,0,20,0"/><TextBlock x:Name="DateTimeLabel" FontSize="12" Foreground="#E0EDF7" AutomationProperties.Name="当前日期和时间"/></StackPanel>
    </Grid>
  </Border>
</Window>
