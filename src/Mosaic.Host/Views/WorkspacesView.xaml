<UserControl x:Class="Mosaic.Host.Views.WorkspacesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="26,14,26,14"><Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="50"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="工作空间" FontSize="28" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Ellipse Width="6" Height="6" Fill="{StaticResource GreenBrush}" Margin="0,0,8,0"/><TextBlock Text="正在使用：" FontSize="12" Foreground="#88A9C4"/><TextBlock Text="{Binding CurrentName}" FontSize="12" Foreground="#B8DDFA"/></StackPanel></StackPanel>
    <Grid Grid.Row="1" IsEnabled="{Binding IsIdle}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
      <ListBox x:Name="WorkspaceList" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="工作空间列表" Margin="0,0,18,0"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tile" Background="#182735" CornerRadius="11" BorderBrush="#2C4054" BorderThickness="1" Padding="18"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="#29445D"/><Setter TargetName="Tile" Property="BorderBrush" Value="#699FC6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="&#xE81E;" Style="{StaticResource Icon}" FontSize="24" Foreground="#85C7F8" HorizontalAlignment="Left" Margin="0,0,0,12"/><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="#8FACC3" FontSize="11" Margin="0,8,0,0"><Run Text="{Binding ResourceCount, Mode=OneWay}"/><Run Text=" 个资源入口"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      <Border Grid.Column="1" Background="#162432" BorderBrush="#2C4054" BorderThickness="1" CornerRadius="12" Padding="24"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding HasSelection}"><TextBlock Text="{Binding Selected.Name}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectionSummary}" Foreground="#8EAFC9" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,20"/><TextBlock Text="保存并切换你的 Mosaic 环境" FontSize="14"/><TextBlock Text="• 每个工作空间拥有独立的 Dashboard 布局、Dock 与资源入口。&#x0a;• 切换前保存当前 Dock，返回时恢复。&#x0a;• 笔记和待办共享，不会因切换消失。&#x0a;• 不切换 Windows 虚拟桌面，不启动或关闭其他应用。" Foreground="#8EA7BD" FontSize="12" TextWrapping="Wrap" LineHeight="24" Margin="0,12,0,24"/><Button x:Name="SwitchWorkspaceButton" Content="{Binding SwitchLabel}" Click="OnSwitchClick" Style="{StaticResource AccentButton}" HorizontalContentAlignment="Center" AutomationProperties.Name="切换工作空间"/><Button Content="查看此工作空间的资源" Click="OnResourcesClick" Style="{StaticResource QuietButton}" FontSize="12" Margin="0,8,0,18"/><TextBlock Text="工作空间名称" Foreground="#8DA9C0" FontSize="11" Margin="0,0,0,6"/><TextBox Text="{Binding Rename, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="工作空间名称"/><Button Content="保存名称" Click="OnRenameClick" Style="{StaticResource QuietButton}" FontSize="11" HorizontalAlignment="Left" Margin="0,6,0,0"/></StackPanel></ScrollViewer></Border>
    </Grid>
    <Border Grid.Row="2" Background="#172635" CornerRadius="10" Padding="16" Margin="0,18,0,0" IsEnabled="{Binding IsIdle}"><StackPanel><TextBlock Text="新建工作空间" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" FontSize="12" AutomationProperties.Name="新工作空间名称" ToolTip="可选名称；留空使用预设名称"/><Button Grid.Column="1" Content="克隆当前" Click="OnCloneClick" Margin="10,0,0,0" FontSize="11"/><Button Grid.Column="2" Content="+ AI Lab" Click="OnAiClick" Margin="7,0,0,0" FontSize="11"/><Button Grid.Column="3" Content="+ Writing" Click="OnWritingClick" Margin="7,0,0,0" FontSize="11"/></Grid></StackPanel></Border>
    <TextBlock Grid.Row="3" Text="{Binding Status}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#8AACC7"/><Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="#FFC28E"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </Grid>
</UserControl>
