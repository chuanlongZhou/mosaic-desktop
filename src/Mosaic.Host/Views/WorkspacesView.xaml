<UserControl x:Class="Mosaic.Host.Views.WorkspacesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="26,14,26,14"><Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="50"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="工作空间" FontSize="28" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Ellipse Width="6" Height="6" Fill="{DynamicResource GreenBrush}" Margin="0,0,8,0"/><TextBlock Text="正在使用：" FontSize="12" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding CurrentName}" FontSize="12" Foreground="{DynamicResource AccentTextBrush}"/></StackPanel></StackPanel>
    <Grid Grid.Row="1" IsEnabled="{Binding IsIdle}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
      <ListBox x:Name="WorkspaceList" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="工作空间列表" Margin="0,0,18,0"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tile" Background="{DynamicResource PanelBrush}" CornerRadius="11" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="&#xE81E;" Style="{StaticResource Icon}" FontSize="24" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Left" Margin="0,0,0,12"/><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0"><Run Text="{Binding ResourceCount, Mode=OneWay}"/><Run Text=" 个资源入口"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
        <Grid IsEnabled="{Binding HasSelection}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="{Binding Selected.Name}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectionSummary}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,16"/></StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="切换桌面组件布局、Dock 和资源入口。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"/>
            <Expander Header="切换包含哪些内容" Margin="0,0,0,14"><TextBlock Text="桌面组件的启用状态、位置和大小分别保存。笔记与待办跨工作空间共享。Windows 虚拟桌面和其他应用不受影响。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/></Expander>
            <Button Content="查看此工作空间的资源" Click="OnResourcesClick" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
            <TextBlock Text="工作空间名称" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,6"/><TextBox Text="{Binding Rename, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="工作空间名称"/><Button Content="保存名称" Click="OnRenameClick" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
          </StackPanel></ScrollViewer>
          <Button x:Name="SwitchWorkspaceButton" Grid.Row="2" Content="{Binding SwitchLabel}" Click="OnSwitchClick" Style="{StaticResource AccentButton}" IsEnabled="{Binding CanSwitch}" HorizontalContentAlignment="Center" AutomationProperties.Name="切换工作空间" Margin="0,16,0,0"/>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,18,0,0" IsEnabled="{Binding IsIdle}"><StackPanel><TextBlock Text="新建工作空间" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" FontSize="12" AutomationProperties.Name="新工作空间名称" ToolTip="可选名称；留空使用预设名称"/><Button Grid.Column="1" Content="克隆当前" Click="OnCloneClick" Margin="10,0,0,0" FontSize="12"/><Button Grid.Column="2" Content="+ AI Lab" Click="OnAiClick" Margin="7,0,0,0" FontSize="12"/><Button Grid.Column="3" Content="+ Writing" Click="OnWritingClick" Margin="7,0,0,0" FontSize="12"/></Grid></StackPanel></Border>
    <TextBlock Grid.Row="3" Text="{Binding Status}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </Grid>
</UserControl>
