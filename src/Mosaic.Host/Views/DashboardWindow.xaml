<Window x:Class="Mosaic.Host.Views.DashboardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Mosaic.Host.Controls" Title="Mosaic · 设置与插件" Width="1280" Height="850"
        MinWidth="720" MinHeight="560" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Loaded="OnLoaded" Closing="OnClosing" StateChanged="OnStateChanged" PreviewKeyDown="OnKeyDown">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" /></shell:WindowChrome.WindowChrome>
  <Window.Resources><ResourceDictionary Source="../Themes/WidgetTemplates.xaml"/></Window.Resources>
  <Border BorderBrush="#2A3A4C" BorderThickness="1" CornerRadius="11" Background="{StaticResource BackgroundBrush}">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Background="#131E2B" BorderBrush="#253344" BorderThickness="0,0,1,0" CornerRadius="11,0,0,11">
        <Grid><Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /><RowDefinition Height="86" /></Grid.RowDefinitions>
          <Grid Width="28" Height="28"><Grid.LayoutTransform><RotateTransform Angle="-8" /></Grid.LayoutTransform><UniformGrid Rows="2" Columns="2"><Border Background="#A0D6FF" Margin="2" CornerRadius="2" /><Border Background="#5A9FD9" Margin="2" CornerRadius="2" /><Border Background="#5A9FD9" Margin="2" CornerRadius="2" /><Border Background="#3470A5" Margin="2" CornerRadius="2" /></UniformGrid></Grid>
          <StackPanel Grid.Row="1" Margin="9,16,9,0">
            <Button Style="{StaticResource QuietButton}" Padding="4,12" Margin="0,0,0,12" Click="OnDesktopClick" ToolTip="返回桌面" AutomationProperties.Name="返回桌面"><StackPanel><TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" /><TextBlock Text="桌面" FontSize="10" Margin="0,8,0,0" HorizontalAlignment="Center" /></StackPanel></Button>
            <Button Style="{StaticResource QuietButton}" Padding="4,12" Margin="0,0,0,12" Click="OnSearchClick" ToolTip="全局搜索 · Ctrl+K" AutomationProperties.Name="全局搜索"><StackPanel><TextBlock Text="&#xE721;" Style="{StaticResource Icon}" /><TextBlock Text="搜索" FontSize="10" Margin="0,8,0,0" HorizontalAlignment="Center" /></StackPanel></Button><Button x:Name="DashboardNav" Style="{StaticResource QuietButton}" Background="#223C56" Padding="4,12" Click="OnDashboardClick" ToolTip="桌面插件管理" AutomationProperties.Name="桌面插件"><StackPanel><TextBlock Text="&#xECA5;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="插件" Foreground="#B9DCFA" FontSize="10" Margin="0,8,0,0" HorizontalAlignment="Center" /></StackPanel></Button>
            <Button x:Name="LibraryNav" Style="{StaticResource QuietButton}" Padding="4,12" Margin="0,12,0,0" Click="OnLibraryClick" ToolTip="Resource Library" AutomationProperties.Name="资源库"><StackPanel><TextBlock Text="&#xE8A9;" Style="{StaticResource Icon}"/><TextBlock Text="资源库" FontSize="10" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="WorkspacesNav" Style="{StaticResource QuietButton}" Padding="4,12" Margin="0,12,0,0" Click="OnWorkspacesClick" ToolTip="切换 Mosaic 工作空间" AutomationProperties.Name="工作空间"><StackPanel><TextBlock Text="&#xE81E;" Style="{StaticResource Icon}"/><TextBlock Text="工作空间" FontSize="10" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
          </StackPanel>
          <Button Grid.Row="2" Style="{StaticResource QuietButton}" Margin="9,12" Padding="4,12" Click="OnSettingsClick" ToolTip="Mosaic 设置" AutomationProperties.Name="Mosaic 设置"><StackPanel><TextBlock Text="&#xE713;" Style="{StaticResource Icon}" /><TextBlock Text="设置" FontSize="10" Margin="0,7,0,0" HorizontalAlignment="Center" /></StackPanel></Button>
        </Grid>
      </Border>
      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="38" /></Grid.RowDefinitions>
        <Grid Margin="24,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="MOSAIC" FontSize="11" FontWeight="SemiBold" Foreground="#CEE0F0" /><TextBlock Text="/" Foreground="#52677F" Margin="14,0" /><TextBlock Text="{Binding WorkspaceName}" Foreground="{StaticResource MutedBrush}" FontSize="11" /><Border Background="#203449" CornerRadius="4" Margin="12,0,0,0" Padding="6,2"><TextBlock Text="{Binding Time}" Foreground="#8DB6D8" FontSize="8" /></Border></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button x:Name="DesktopModeButton" Content="启用 Mosaic 桌面" Click="OnDesktopModeClick" FontSize="11" Margin="0,0,12,0" AutomationProperties.Name="切换桌面模式"/><Button Style="{StaticResource QuietButton}" Content="−" Width="40" Padding="0" Click="OnMinimizeClick" AutomationProperties.Name="最小化" /><Button Style="{StaticResource QuietButton}" Width="40" Padding="0" Click="OnMaximizeClick" AutomationProperties.Name="最大化或还原"><TextBlock Style="{StaticResource Icon}" Text="&#xE922;" FontSize="11" /></Button><Button Style="{StaticResource QuietButton}" Content="×" FontSize="18" Width="40" Padding="0" Click="OnCloseClick" AutomationProperties.Name="关闭设置中心" /></StackPanel>
        </Grid>
        <ScrollViewer x:Name="DashboardPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,12,24,24">
          <StackPanel>
            <Grid Margin="0,3,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="工作台" FontSize="29" FontWeight="SemiBold" /><TextBlock Text="{Binding Greeting}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" /></StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsBrowsing, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Today}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,18,0" /><Button Click="OnEditClick" Style="{StaticResource AccentButton}" AutomationProperties.Name="编辑布局"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0" /><TextBlock Text="编辑布局" FontSize="12" /></StackPanel></Button></StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsEditing, Converter={StaticResource BoolVisibility}}"><Button Content="↶" ToolTip="撤销 Ctrl+Z" Click="OnUndoClick" Style="{StaticResource QuietButton}" Margin="0,0,4,0" /><Button Content="↷" ToolTip="重做 Ctrl+Y" Click="OnRedoClick" Style="{StaticResource QuietButton}" Margin="0,0,8,0" /><Button Content="添加组件" Click="OnAddWidgetClick" Margin="0,0,8,0" FontSize="12" /><Button Content="取消" Click="OnCancelClick" Style="{StaticResource QuietButton}" FontSize="12" Margin="0,0,8,0" /><Button x:Name="SaveLayoutButton" Content="保存布局" Click="OnSaveLayoutClick" Style="{StaticResource AccentButton}" FontSize="12" /></StackPanel>
              </StackPanel>
            </Grid>
            <ItemsControl x:Name="WidgetItems" ItemsSource="{Binding Widgets}" SizeChanged="OnWidgetItemsSizeChanged">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:DashboardPanel Columns="{Binding Columns}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16,12,16,14">
                  <Grid><Grid.RowDefinitions><RowDefinition Height="20" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid><TextBlock Text="{Binding Title}" FontSize="11" Foreground="#C0D0E0" FontWeight="SemiBold" />
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-8,-8,0" Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}">
                        <Thumb Width="30" Height="26" Cursor="SizeAll" DragStarted="OnWidgetDragStarted" DragDelta="OnWidgetDragDelta" DragCompleted="OnWidgetDragCompleted" ToolTip="拖动组件" AutomationProperties.Name="移动组件"><Thumb.Template><ControlTemplate><Border Background="Transparent"><TextBlock Text="&#xE700;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource AccentBrush}" /></Border></ControlTemplate></Thumb.Template></Thumb>
                        <Button Content="×" MinHeight="26" Width="24" Padding="0" Style="{StaticResource QuietButton}" Click="OnRemoveWidgetClick" ToolTip="移除组件（保留内容）" AutomationProperties.Name="移除组件" />
                      </StackPanel>
                    </Grid>
                    <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplateSelector="{StaticResource WidgetSelector}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                  </Grid>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="你的桌面，按你的方式。" HorizontalAlignment="Center" FontSize="11" Foreground="#5E748B" Margin="0,24,0,0" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PluginManagementPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,20">
          <StackPanel>
            <TextBlock Text="桌面插件" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="控件固定在桌面，应用窗口会自然覆盖它们。平时直接使用笔记和待办；需要移动或缩放时，先进入编辑桌面布局。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,20"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
              <Button Content="编辑桌面布局" Click="OnEditDesktopClick" Style="{StaticResource AccentButton}" Margin="0,0,12,0"/>
              <Button Content="桌面与 Dock 设置" Click="OnSettingsClick"/>
            </StackPanel>
            <ItemsControl x:Name="PluginManagerItems">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border Width="270" Margin="0,0,16,16" Padding="20" Background="{StaticResource PanelBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                  <StackPanel><CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=OneWay}" Click="OnPluginToggle" FontSize="16"/><TextBlock Text="固定在桌面 · 编辑模式调整布局" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,12,0,0"/></StackPanel>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="资源库与工作空间仍可从左侧打开。关闭本窗口后，桌面插件、时间栏和 Dock 继续运行。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
          </StackPanel>
        </ScrollViewer>
        <ContentControl x:Name="SectionContent" Grid.Row="1" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <Border Grid.Row="2" BorderBrush="#223143" BorderThickness="0,1,0,0" Padding="24,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="5" Height="5" Fill="{StaticResource GreenBrush}" Margin="0,0,8,0" /><TextBlock Text="{Binding Status}" FontSize="10.5" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="#FFBE92" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel><TextBlock Grid.Column="1" Text="MOSAIC  ·  V0.7" FontSize="9" Foreground="#647B92" VerticalAlignment="Center" /></Grid></Border>
      </Grid>
      <Grid x:Name="SettingsOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#A6000000" Panel.ZIndex="10" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Border Width="420" HorizontalAlignment="Right" Background="#172231" BorderBrush="#34465B" BorderThickness="1,0,0,0" Padding="28,28,28,110">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid><TextBlock Text="Mosaic 设置" FontSize="23" FontWeight="SemiBold" /><Button Content="×" Width="32" HorizontalAlignment="Right" Padding="0" Style="{StaticResource QuietButton}" Click="OnDismissSettingsClick" AutomationProperties.Name="关闭设置" /></Grid>
            <ScrollViewer Grid.Row="1" Margin="0,28,0,0" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="桌面模块" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,0,12" /><CheckBox x:Name="OverlayEnabledCheck" Content="启用 Mosaic 覆盖桌面（隐藏 Windows 任务栏）" Margin="0,4"/><CheckBox x:Name="MenuBarAutoHideCheck" Content="顶部菜单栏：最大化时自动隐藏" Margin="0,4"/><CheckBox x:Name="SyncPinsCheck" Content="自动读取 Windows 任务栏固定应用" Margin="0,4"/><CheckBox x:Name="DockEnabledCheck" Content="显示 Dock" Margin="0,4" /><CheckBox x:Name="ClockEnabledCheck" Content="启用桌面时钟插件" Margin="0,4" /><CheckBox x:Name="LibraryEnabledCheck" Content="显示资源库入口" Margin="0,4"/><CheckBox x:Name="WorkspacesEnabledCheck" Content="显示工作空间入口" Margin="0,4"/><TextBlock Text="Dock 图标大小" Margin="0,16,0,8"/><DockPanel><TextBlock Text="小" VerticalAlignment="Center"/><TextBlock Text="大" DockPanel.Dock="Right" VerticalAlignment="Center"/><Slider x:Name="DockSizeSlider" ValueChanged="OnDockSizeChanged" Minimum="24" Maximum="80" TickFrequency="2" IsSnapToTickEnabled="True" Margin="12,0" AutomationProperties.Name="Dock 图标大小"/></DockPanel><TextBlock x:Name="DockSizeLabel" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,12"/><CheckBox x:Name="AutoHideCheck" Content="Dock：最大化时自动隐藏" Margin="0,4" /><CheckBox x:Name="StartupDashboardCheck" Content="启动时打开设置中心" Margin="0,4" /><Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,24" /><TextBlock Text="键盘入口" Foreground="{StaticResource AccentBrush}" FontSize="12" /><TextBlock x:Name="HotkeyLabel" Text="Ctrl + Alt + D  打开设置中心" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" /><TextBlock Text="Ctrl+Alt+M 切换 Mosaic / Windows。&#x0a;桌面或无最大化应用时，两条栏保持显示。&#x0a;Mosaic 模式下单按 Win 不弹出开始菜单，Win+D 等组合快捷键仍可使用。&#x0a;切回 Windows 或退出后恢复。" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="22" Margin="0,24,0,0" /><Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,24" /><TextBlock Text="本地数据" Foreground="{StaticResource AccentBrush}" FontSize="12" /><TextBlock x:Name="DataPathLabel" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,12" /><Button Content="打开 JSON 配置目录" Click="OnOpenDataClick" HorizontalAlignment="Left" FontSize="12" /></StackPanel></ScrollViewer>
            <StackPanel Grid.Row="2"><TextBlock x:Name="SettingsErrorLabel" Foreground="#FFBE92" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" /><Button x:Name="SaveSettingsButton" Content="保存设置" Style="{StaticResource AccentButton}" Click="OnSaveSettingsClick" HorizontalContentAlignment="Center" /></StackPanel>
          </Grid>
        </Border>
      </Grid>
      <ResizeGrip Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="20" Height="20" shell:WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="20"/>
    </Grid>
  </Border>
</Window>
