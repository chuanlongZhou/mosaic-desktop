<Window x:Class="Mosaic.Host.Views.DockWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mosaic · Dock" Height="84" Width="340"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        AllowsTransparency="True" Background="#01000000" Loaded="OnLoaded" MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
  <Border x:Name="DockBorder" Background="#182331" CornerRadius="13" BorderBrush="#3A5068" BorderThickness="1" Padding="8,7" Margin="0,0,0,8">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
      <ScrollViewer x:Name="DockScroll" PreviewMouseWheel="OnDockWheel" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="HorizontalOnly">
        <ItemsControl x:Name="DockItems"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Button Width="56" Height="60" Margin="1,0" Padding="5" Style="{StaticResource QuietButton}" ToolTip="{Binding Title}"
                    AutomationProperties.Name="{Binding Title}" Click="OnItemClick" PreviewMouseLeftButtonDown="OnItemMouseDown"
                    PreviewMouseMove="OnItemMouseMove" AllowDrop="True" Drop="OnItemDrop" ContextMenuOpening="OnItemContextMenuOpening">
              <Button.ContextMenu><ContextMenu><MenuItem Header="打开" /></ContextMenu></Button.ContextMenu>
              <Grid Width="44" Height="52">
                <Border Width="42" Height="42" VerticalAlignment="Top" CornerRadius="10" Background="#273E53">
                  <Grid><TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="23" Foreground="#A8D8FF" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasIcon}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Image Source="{Binding Icon}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
                </Border>
                <Ellipse Width="4" Height="4" Fill="#D9EFFF" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}"/>
              </Grid>
            </Button>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Button Grid.Column="1" Content="+" FontSize="24" Foreground="#8FA8BF" Style="{StaticResource QuietButton}" Margin="5,0,0,0" Padding="0" Click="OnAddClick" ToolTip="添加 Dock 入口" AutomationProperties.Name="添加 Dock 入口" />
      <TextBlock x:Name="DockTimeLabel" Grid.Column="2" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#D7E8F5" AutomationProperties.Name="Dock 时间"/>
    </Grid>
  </Border>
</Window>
