<UserControl x:Class="Mosaic.Host.Views.LibraryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Mosaic.Host.Controls" SizeChanged="OnSizeChanged">
  <UserControl.Resources>
    <Style x:Key="ResourceRow" TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="{DynamicResource PanelBrush}" CornerRadius="9" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <DataTemplate x:Key="CardTemplate"><Grid Width="154" Height="136"><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource SelectionBrush}" CornerRadius="7"><TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentTextBrush}"/></Border><TextBlock Text="★" Foreground="{DynamicResource MutedBrush}" Margin="0,4,4,0" HorizontalAlignment="Right" Visibility="{Binding IsFavorite, Converter={StaticResource BoolVisibility}}"/><StackPanel Grid.Row="1" Margin="0,9,0,0"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold" ToolTip="{Binding Name}"/><TextBlock Text="{Binding TypeLabel}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/><TextBlock Text="{Binding Target}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Grid></DataTemplate>
    <DataTemplate x:Key="RowTemplate"><Grid MinHeight="38"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="66"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/><TextBlock Grid.Column="2" Text="{Binding TypeLabel}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Grid.Column="3" Text="{Binding Target}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Grid.Column="4" Text="★" Foreground="{DynamicResource MutedBrush}" Visibility="{Binding IsFavorite, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center"/></Grid></DataTemplate>
    <ItemsPanelTemplate x:Key="CardPanel"><WrapPanel/></ItemsPanelTemplate><ItemsPanelTemplate x:Key="RowPanel"><VirtualizingStackPanel/></ItemsPanelTemplate>
  </UserControl.Resources>
  <Grid Margin="22,12,22,8"><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="资源库" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="文件留在原处，资源在这里相聚。" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="全局搜索" Click="OnSearchClick" Style="{StaticResource QuietButton}" FontSize="12" Margin="0,0,6,0"/><Button x:Name="AddResourceButton" Content="+ 添加资源" Click="OnAddClick" Style="{StaticResource AccentButton}" FontSize="12"/></StackPanel></Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="158"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="266"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox x:Name="NavigationList" ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedNavigation}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="资源库导航"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource ResourceRow}"><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Padding" Value="0"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Left" Foreground="{DynamicResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="1" Margin="0,8,0,0"><Button Content="+ 新建集合" Click="OnNewCollectionClick" Style="{StaticResource QuietButton}" FontSize="12"/><Button Content="编辑集合" Click="OnEditCollectionClick" IsEnabled="{Binding CanEditCollection}" Style="{StaticResource QuietButton}" FontSize="12"/></StackPanel></Grid>
      <Grid Grid.Column="1" Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="LibraryQuery" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" FontSize="12" Padding="10,7" ToolTip="搜索已登记资源的名称、路径和标签" AutomationProperties.Name="搜索资源库"/><TextBlock Text="搜索已登记资源…" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Query}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Grid.Column="1" Content="▦" Click="OnCardsClick" Style="{StaticResource QuietButton}" Margin="8,0,2,0" ToolTip="卡片视图" AutomationProperties.Name="卡片视图"/><Button Grid.Column="2" Content="☰" Click="OnListClick" Style="{StaticResource QuietButton}" ToolTip="列表视图" AutomationProperties.Name="列表视图"/></Grid>
        <Grid Grid.Row="1" Margin="0,5,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" DisplayMemberPath="Label" FontSize="12" AutomationProperties.Name="资源类型筛选"/><TextBox Grid.Column="1" Text="{Binding TagFilter, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Margin="8,0,0,0" FontSize="12" Padding="8,5" ToolTip="按标签筛选，可留空" AutomationProperties.Name="标签筛选"/><TextBlock Grid.Column="1" Text="筛选标签" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="18,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TagFilter}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Grid.Column="2" Content="详情" Click="OnDetailsClick" Style="{StaticResource QuietButton}" FontSize="12" Margin="5,0,0,0"/></Grid>
        <Grid Grid.Row="2"><ListBox x:Name="ResourcesList" SelectionMode="Extended" SelectionChanged="OnResourceSelectionChanged" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}" ItemContainerStyle="{StaticResource ResourceRow}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" MouseDoubleClick="OnResourceDoubleClick" AutomationProperties.Name="资源列表"><ListBox.Style><Style TargetType="ListBox"><Setter Property="ItemsPanel" Value="{StaticResource RowPanel}"/><Setter Property="ItemTemplate" Value="{StaticResource RowTemplate}"/><Style.Triggers><DataTrigger Binding="{Binding IsCards}" Value="True"><Setter Property="ItemsPanel" Value="{StaticResource CardPanel}"/><Setter Property="ItemTemplate" Value="{StaticResource CardTemplate}"/></DataTrigger></Style.Triggers></Style></ListBox.Style></ListBox><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" Margin="16"><TextBlock Text="&#xE8A9;" Style="{StaticResource Icon}" FontSize="36" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="这里还没有匹配的资源" HorizontalAlignment="Center" FontSize="14" Margin="0,18,0,8"/><TextBlock Text="拖入文件或文件夹，或从全局搜索收藏资源。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><Button Content="添加文件或文件夹" Click="OnAddClick" Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Margin="0,18,0,0"/></StackPanel></Grid>
        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CountLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="‹" Click="OnPreviousClick" IsEnabled="{Binding CanPrevious}" Style="{StaticResource QuietButton}" MinHeight="28" Padding="10,0"/><Button Content="›" Click="OnNextClick" IsEnabled="{Binding CanNext}" Style="{StaticResource QuietButton}" MinHeight="28" Padding="10,0"/></StackPanel></Grid>
      </Grid>
      <Border x:Name="DetailsPanel" Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel IsEnabled="{Binding IsIdle}">
        <TextBlock Text="{Binding Selected.Glyph}" Style="{StaticResource Icon}" FontSize="30" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextBrush}" Margin="0,2,0,14"/><TextBlock Text="{Binding Selected.Name}" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap"/><TextBlock Text="{Binding Selected.TypeLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,10"/><TextBlock Text="{Binding Selected.Target}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding Information}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,12"/>
        <TextBlock Text="{Binding SelectionLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/><StackPanel IsEnabled="{Binding HasSelection}"><Button Content="{Binding OpenLabel}" Click="OnOpenClick" Style="{StaticResource AccentButton}" HorizontalContentAlignment="Left" FontSize="12"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Button Content="定位" Click="OnRevealClick" IsEnabled="{Binding CanReveal}" Style="{StaticResource QuietButton}" FontSize="12"/><Button Content="复制路径" Click="OnCopyClick" IsEnabled="{Binding CanReveal}" Style="{StaticResource QuietButton}" FontSize="12"/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="{Binding FavoriteLabel}" Click="OnFavoriteClick" Style="{StaticResource QuietButton}" FontSize="12"/><Button Content="固定 Dock" Click="OnPinClick" Style="{StaticResource QuietButton}" FontSize="12"/></StackPanel>
          <TextBlock Text="标签 · 用逗号分隔" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,12,0,6"/><TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" MaxLength="650" FontSize="12" AutomationProperties.Name="资源库标签"/><Button Content="{Binding SaveTagsLabel}" ToolTip="将标签框内的完整列表保存到所选资源；不会影响原文件。" Click="OnSaveTagsClick" Style="{StaticResource QuietButton}" FontSize="12" HorizontalAlignment="Left"/>
          <TextBlock Text="集合" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,6"/><ComboBox x:Name="CollectionTarget" ItemsSource="{Binding ManualCollections}" SelectedItem="{Binding TargetCollection, Mode=TwoWay}" DisplayMemberPath="Name" FontSize="12" AutomationProperties.Name="目标集合"/><Button Content="加入集合" Click="OnAddToCollectionClick" Style="{StaticResource QuietButton}" FontSize="12" HorizontalAlignment="Left"/><Button Content="从集合移除" Click="OnRemoveFromCollectionClick" IsEnabled="{Binding CanRemoveMember}" Style="{StaticResource QuietButton}" FontSize="12" HorizontalAlignment="Left"/>
          <TextBlock Text="工作空间入口" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,6"/><ComboBox x:Name="WorkspaceTarget" ItemsSource="{Binding Workspaces}" SelectedItem="{Binding TargetWorkspace, Mode=TwoWay}" DisplayMemberPath="Name" FontSize="12" AutomationProperties.Name="目标工作空间"/><Button Content="加入工作空间" Click="OnAddToWorkspaceClick" Style="{StaticResource QuietButton}" FontSize="12" HorizontalAlignment="Left"/><Button Content="从当前筛选的工作空间移除" Click="OnRemoveFromWorkspaceClick" Style="{StaticResource QuietButton}" FontSize="12" HorizontalAlignment="Left"/>
        </StackPanel>
        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12"/><Image Source="{Binding PreviewImage}" MaxWidth="232" MaxHeight="180" Stretch="Uniform"/><TextBlock Text="{Binding PreviewText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel></ScrollViewer></Border>
    </Grid>
    <TextBlock Grid.Row="2" Text="{Binding Status}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </Grid>
</UserControl>
