<Window x:Class="Mosaic.PetWorldDemo.WorldWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mosaic · 图书馆茶室 · 五位 AI 娘" Width="1500" Height="1000" MinWidth="1020" MinHeight="720" WindowStartupLocation="CenterScreen"
        Background="#EEE9DE" Foreground="#ECE9DE" FontFamily="Microsoft YaHei UI" FontSize="13" PreviewKeyDown="OnKeyDown">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Background" Value="#343F38"/><Setter Property="Foreground" Value="#EAE9DF"/><Setter Property="BorderBrush" Value="#4B574B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#4B5C4C"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#24342A"/></Style>
  </Window.Resources>
  <Grid x:Name="Shell">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="Header" Background="#26372D" Padding="26,18">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#3D5040" CornerRadius="14" Padding="12,5"><TextBlock Text="本地剧本 · 无需联网" Foreground="#BFCDB4" FontSize="12"/></Border><Button Content="沉浸预览  ↗" Click="OnImmersive" Margin="14,0,0,0"/></StackPanel>
        <StackPanel><TextBlock Text="MOSAIC / LITTLE WORLD" Foreground="#A9B79E" FontSize="11"/><TextBlock Text="窗边的第五个座位" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="AsideColumn" Width="286"/></Grid.ColumnDefinitions>
      <Viewbox x:Name="SceneBox" Stretch="Uniform" Margin="0,8,0,0"/>
      <Border x:Name="Aside" Grid.Column="1" Background="#2C3C31" Padding="20,20,20,12">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="她们正在做什么" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="点选角色，或直接把她轻轻拎起来" Foreground="#ADBAA4" FontSize="11" Margin="0,6,0,17"/></StackPanel>
          <StackPanel x:Name="Roster" Grid.Row="1"/>
          <StackPanel Grid.Row="2" Margin="0,13,0,0"><TextBlock x:Name="SelectedTitle" Text="和 Claude 互动" Foreground="#C2CBB7" Margin="0,0,0,10"/><UniformGrid Columns="2"><Button Content="摸摸头" Click="OnPat" Margin="0,0,4,6"/><Button Content="递茶点" Click="OnFeed" Margin="4,0,0,6"/><Button Content="打个招呼" Click="OnGreet" Margin="0,0,4,0"/><Button Content="一枚纸 token" Click="OnToken" Margin="4,0,0,0"/></UniformGrid></StackPanel>
          <StackPanel Grid.Row="3" Margin="0,24,0,0"><TextBlock Text="刚才，她们说……" FontSize="12" Foreground="#A8B69F"/><TextBlock x:Name="RecentLines" TextWrapping="Wrap" Foreground="#D1D6C8" FontSize="12" LineHeight="21" Margin="0,10,0,0"/><TextBlock x:Name="CoverageLabel" FontSize="11" Foreground="#A8B69F" Margin="0,16,0,0" TextWrapping="Wrap"/></StackPanel>
        </Grid>
        </ScrollViewer>
      </Border>
      <Border x:Name="ExitHint" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,20,0" Padding="12,7" Background="#E6F5F0E2" CornerRadius="7"><TextBlock Text="Esc 返回 · 空格暂停 · → 下一幕" Foreground="#51604E" FontSize="12"/></Border>
    </Grid>
    <Border x:Name="Footer" Grid.Row="2" Background="#26372D" Padding="24,14">
      <StackPanel>
        <DockPanel Margin="0,0,0,13"><TextBlock x:Name="ChapterLabel" DockPanel.Dock="Right" Foreground="#A9B89F" FontSize="12"/><TextBlock x:Name="SummaryLabel" TextWrapping="Wrap" FontSize="14" Foreground="#E2E4D6" Margin="0,0,20,0"/></DockPanel>
        <WrapPanel VerticalAlignment="Center"><Button x:Name="PauseButton" Content="Ⅱ  暂停" Click="OnPause" Margin="0,0,8,0"/><Button Content="下一幕  →" Click="OnNext" Margin="0,0,18,0"/><ComboBox x:Name="ChapterPicker" Width="230" SelectionChanged="OnChapterChanged" VerticalAlignment="Center" Margin="0,0,10,0"/><Button x:Name="SpeedButton" Content="1× 节奏" Click="OnSpeed"/><TextBlock Text="窗口 / 沉浸演示" Foreground="#A9B89F" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="12"/></WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
